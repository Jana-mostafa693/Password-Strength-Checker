# Copy to .env and edit. NEVER commit the real .env file.
# Leave DB_HOST empty to run locally WITHOUT a database.

# vm | docker | kubernetes | hybrid   (any other value, e.g. "local", is allowed for development)
ENV_NAME=docker

# --- PostgreSQL (all optional; database is used only when DB_HOST is set) ---
# vm: localhost | docker: db | kubernetes: your DB service name | hybrid: vm-db
DB_HOST=db
DB_PORT=5432
DB_NAME=passcheck
DB_USER=passcheck
DB_PASSWORD=CHANGE_ME_use_the_team_private_password
